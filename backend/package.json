{
  "name": "health-checker",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec \"ts-node -r tsconfig-paths/register -r dotenv/config\" src/index.ts",
    "lint": "eslint src",
    "test:unit": "cross-env NODE_ENV=test jest --testPathPattern=\"tests/unit\"",
    "test:integration": "cross-env NODE_ENV=test jest --testPathPattern=\"tests/contract|tests/integration\"",
    "test:all": "cross-env NODE_ENV=test jest",
    "test:feature": "cross-env NODE_ENV=test npx cucumber-js --require-module ts-node/register --require tsconfig-paths/register --require src/**/*steps.ts src/**/*.feature ",
    "db:migrate": "ts-node -r tsconfig-paths/register ./src/database/migrate-all.ts",
    "db:seed": "ts-node -r tsconfig-paths/register ./src/database/seed-all.ts",
    "db:clear": "ts-node -r tsconfig-paths/register ./src/database/clear-all.ts",
    "db:drop": "ts-node -r tsconfig-paths/register ./src/database/drop-all.ts",
    "command": "ts-node ./src/commands",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,css,md}\"",
    "repo:sync": "ts-node -r tsconfig-paths/register src/commands/syncRepos.ts",
    "alert": "ts-node -r tsconfig-paths/register src/commands/alertRunner.ts",
    "project:setsp": "ts-node -r tsconfig-paths/register src/commands/projectSetSp.ts",
    "checkIssues": "ts-node -r tsconfig-paths/register src/commands/checkIssues.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/openai": "^1.3.22",
    "@octokit/core": "^7.0.2",
    "@octokit/graphql": "^9.0.1",
    "@octokit/plugin-rest-endpoint-methods": "^16.0.0",
    "@octokit/rest": "^22.0.0",
    "ai": "^4.3.16",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.10.0",
    "cliui": "6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-promise-router": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "sequelize": "^6.37.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "wrap-ansi": "6.2.0",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/chai": "^5.0.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.18",
    "@types/date-fns": "^2.5.3",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-filenames": "^1.3.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
